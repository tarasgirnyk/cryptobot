CRYPTBOT_PUBLIC_PORT=8771
SCAN_INTERVAL_SEC=5
ENABLED_EXCHANGES=Binance,Bybit,BingX,MEXC

# Safe modes: observe or paper. demo/live accepted but the real order executor
# is not wired yet (Milestone B/C) — they currently behave like paper.
AUTOMATION_MODE=observe
PAPER_ENTRY_NET_PCT=0.30
PAPER_EXIT_GROSS_PCT=0.10
PAPER_MIN_PRICE_CAPTURE_PCT=0.15
PAPER_TOTAL_STOP_PCT=-2.00
PAPER_NOTIONAL_USDT=1000
PAPER_MAX_HOLD_HOURS=24
MAX_OPEN_POSITIONS=3
MAX_SAME_ROUTE_POSITIONS=2
MIN_TURNOVER_USDT=1000000
MAX_SLIPPAGE_PCT=0.15
MAX_PRICE_DEVIATION_PCT=10
SYMBOL_COOLDOWN_SEC=1800
# Compatibility setting; order-book execution gates apply at every notional.
DEPTH_GATE_MIN_NOTIONAL=2000
# Block a new entry within this many minutes of an unfavourable funding settlement.
FUNDING_ENTRY_BUFFER_MIN=10
# Default funding interval (hours) per exchange until per-symbol values are fetched.
FUNDING_INTERVAL_BINANCE_H=8
FUNDING_INTERVAL_BYBIT_H=8
FUNDING_INTERVAL_BINGX_H=8
FUNDING_INTERVAL_MEXC_H=8
MARKET_STALE_SEC=30
MARKET_ALERT_FAILURES=3
TELEGRAM_REPORT_INTERVAL_SEC=86400
READINESS_MIN_CLOSED_TRADES=50
READINESS_MIN_DAYS=7
READINESS_MAX_STOP_RATE_PCT=20

# --- Execution layer (demo/live) ---
# Which exchanges the order executor may use. MEXC is a stub until its futures
# API is available, so it is excluded by default.
EXECUTION_ENABLED_EXCHANGES=Binance,Bybit,BingX
DEFAULT_LEVERAGE=10
LIVE_NOTIONAL_USDT=50
# demo always uses the exchange sandbox; live always uses the real endpoint.
# This flag only affects observe/paper smoke tests.
EXCHANGE_SANDBOX=true

# Two-leg execution engine.
SIGNAL_TTL_SEC=15
ORDER_TIMEOUT_SEC=10
FILL_TOLERANCE_PCT=2
MARGIN_BUFFER_PCT=25
MARGIN_WARN=0.55
MARGIN_CRITICAL=0.80
MARGIN_LIQ_DISTANCE_CRIT_PCT=5
MARGIN_MONITOR_INTERVAL_SEC=10
# Hard live risk caps — a breach flips the persistent kill switch.
LIVE_MAX_NOTIONAL_PER_POS=500
LIVE_MAX_TOTAL_NOTIONAL=1500
LIVE_MAX_DAILY_LOSS_USDT=50

# API keys, format: key:secret[,key2:secret2]  (rotation is interface-only for now).
# Create keys WITHOUT withdrawal permission. Use different keys for demo and live.
# Any *_API_KEYS var may instead be given as *_API_KEYS_FILE pointing at a file
# (Docker secrets: /run/secrets/...). A direct value takes priority.
BINANCE_API_KEYS=
BYBIT_API_KEYS=
BINGX_API_KEYS=
MEXC_API_KEYS=

# Bearer token required for POST /api/* when set (leave empty for a 127.0.0.1-only
# panel). Also supports API_BEARER_TOKEN_FILE.
API_BEARER_TOKEN=

# Keep real secrets only in .env and never commit that file.
# TELEGRAM_BOT_TOKEN also supports TELEGRAM_BOT_TOKEN_FILE.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USER_IDS=
